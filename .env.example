# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789

# Database. SQLite is the default MVP/dev mode.
# Production: postgresql+asyncpg://radar:radar@postgres:5432/radar
DATABASE_URL=sqlite+aiosqlite:///./data/radar.db

# LLM — OpenAI-compatible. Fill with your own key, never reuse Agent env keys.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai_compatible
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Freelancehunt official API 2.0 token from https://freelancehunt.com/my/api2
FREELANCEHUNT_TOKEN=
FREELANCEHUNT_ENABLED=false

# FL.ru public RSS
FL_RSS_URL=https://www.fl.ru/rss/all.xml
FL_RSS_ENABLED=true
FL_RSS_POLL_SECONDS=300

# Scheduler
FREELANCEHUNT_POLL_SECONDS=180
MAX_JOBS_PER_POLL=40
MAX_NOTIFICATIONS_PER_DAY=30
NOTIFY_SCORE_THRESHOLD=45
FULL_MONITORING=false

# Security
ENCRYPTION_KEY=
LOG_LEVEL=INFO
TZ=UTC
